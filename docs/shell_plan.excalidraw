      "updated": 1783791074867,
      "link": null,
      "locked": false,
      "text": "Initial Features \n1. Interactive Prompt\n2. parse user input\n3. execute system\ncommands like fork,\nexecvp,waitpid etc\n4. built in commands like\npwd, cd, exit,help etc\n5. error handling like\ncommand not found\n6. command history \n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Wuf0s2h6xYQWKhHkX1cGr",
      "originalText": "Initial Features \n1. Interactive Prompt\n2. parse user input\n3. execute system commands like fork, execvp,waitpid etc\n4. built in commands like pwd, cd, exit,help etc\n5. error handling like command not found\n6. command history \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
